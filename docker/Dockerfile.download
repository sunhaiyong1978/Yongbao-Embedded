# syntax=docker/dockerfile:1.14

ARG BASE_IMAGE=ubuntu:22.04

# ============================================================
# Stage 0: 下载软件包源代码
# 执行 ./build.sh -x && ./tools/get_all_package_url.sh -i workbase/step.index, 下载软件包源码。
# ============================================================
FROM ${BASE_IMAGE} AS download_packages
ARG ARCH=loongarch32

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        locales \
        gettext-base \
        git \
        curl \
        wget \
        && locale-gen zh_CN.UTF-8 \
        && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .
# COPY ./download_packages-cache ./${ARCH}/downloads
RUN mkdir -p ./${ARCH}/downloads ./download_packages-cache/foo \
    && mv -v ./download_packages-cache/* ./${ARCH}/downloads/

RUN chmod +x ./${ARCH}/build.sh \
    && cd ./${ARCH} \
    && ./build.sh -x \
    && tools/get_all_package_url.sh -i workbase/step.index

# 源码包统一收集到 /output/downloads
RUN mkdir -p /output/downloads /output/downloads/sources \
    && if [ -d ./${ARCH}/downloads/files ]; then \
              cp -a ./${ARCH}/downloads/files /output/downloads/ ; \
       fi \
    && cp -a ./${ARCH}/downloads/sources/files /output/downloads/sources/ \
    && cp -a ./${ARCH}/downloads/sources/hash /output/downloads/sources/


FROM scratch AS download_packages-out
COPY --from=download_packages /output/downloads /

