# syntax=docker/dockerfile:1.14
 
FROM --platform=linux/amd64 ubuntu:22.04 AS download_packages-amd64
FROM --platform=linux/loong64 ghcr.io/fedora-remix-loongarch/mini-image:f43 AS download_packages-loong64

FROM download_packages-${TARGETARCH} AS download_packages
ARG ARCH=loongarch32
ARG TARGETARCH

ARG DEBIAN_FRONTEND=noninteractive

RUN if [ "${TARGETARCH}" = "amd64" ]; then \
        apt-get update && apt-get install -y --no-install-recommends \
            ca-certificates \
            locales \
            gettext-base \
            git \
            curl \
            wget \
            && locale-gen zh_CN.UTF-8 \
            && rm -rf /var/lib/apt/lists/* ; \
    elif [ "${TARGETARCH}" = "loong64" ]; then \
        dnf update -y && dnf install -y \
            curl \
            wget \
            git \
            glibc-langpack-zh ; \
    else \
        echo "Unsupported architecture: ${TARGETARCH}" >&2; \
        exit 1; \
    fi

WORKDIR /src
COPY . .
RUN mkdir -p ./${ARCH}/downloads ./download_packages-cache/foo \
    && mv -v ./download_packages-cache/* ./${ARCH}/downloads/

RUN chmod +x ./${ARCH}/build.sh \
    && cd ./${ARCH} \
    && ./build.sh -x \
    && tools/get_all_package_url.sh -p -l -i workbase/step.index

# 源码包统一收集到 /output/downloads
RUN mkdir -p /output/downloads /output/downloads/sources \
    && if [ -d ./${ARCH}/downloads/files ]; then \
              cp -a ./${ARCH}/downloads/files /output/downloads/ ; \
       fi \
    && cp -a ./${ARCH}/downloads/sources/files /output/downloads/sources/ \
    && cp -a ./${ARCH}/downloads/sources/hash /output/downloads/sources/


FROM scratch AS download_packages-out
COPY --from=download_packages /output/downloads /

