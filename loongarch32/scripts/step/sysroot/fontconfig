source env/sysroot/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=sysroot
export STEP_PACKAGENAME=fontconfig
export PACKAGE_VERSION=2.18.3
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/sysroot/fontconfig/2.18.3/
rm -rf ${BUILD_DIRECTORY}/fontconfig-2.18.3
tar xvf ${DOWNLOADDIR}/fontconfig-2.18.3.tar.gz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/fontconfig-2.18.3
	
	mkdir cross-build
	pushd cross-build
		meson ${MESON_CONFIG} \
			..
		sed -i "s@gi-docgen \(index\|generate\|gen-index\|gen-deps\|search\|check\|serve\) @& --add-include-path ${SYSROOT_DIR}/usr/share/gir-1.0/ @g" build.ninja
		ninja fcalias.h
		eval ${NINJA_AND_INSTALL}
	popd
	rm -f ${SYSROOT_DIR}/usr/lib${LIB_SUFF}/*.la
popd 
rm -rf ${BUILD_DIRECTORY}/fontconfig-2.18.3
