source env/sysroot/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=sysroot
export STEP_PACKAGENAME=systemd
export PACKAGE_VERSION=261.2
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/sysroot/systemd/261.2/
rm -rf ${BUILD_DIRECTORY}/systemd-261.2
tar xvf ${DOWNLOADDIR}/systemd-261.2.tar.gz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/systemd-261.2
	patch -Np1 -i ${SYSDIR}/files/sysroot/systemd/261.2/patches/0001-systemd-261-add-loongarch32-support.patch 
	patch -Np1 -i ${SYSDIR}/files/sysroot/systemd/261.2/patches/0001-Add-syscalls-file-for-loongarch32.patch 
	 
	pushd src/include/override/sys
		./generate-syscall.py syscall.h syscall-list.txt syscalls-*.txt
	popd
	sed -i -e 's/GROUP="render"/GROUP="video"/' \
           -e 's/GROUP="sgx", //' rules.d/50-udev-default.rules.in
	sed -i "s@Werror=undef',@& '-Wno-error=format-overflow', '-Wno-error=implicit-function-declaration',@g" meson.build

	mkdir -p build
	pushd build
		meson ${MESON_CONFIG} \
		      -Ddefault-dnssec=no -Dfirstboot=false \
		      -Dinstall-tests=false -Dldconfig=false -Dsysusers=false \
		      -Drpmmacrosdir=no -Dhomed=false -Duserdb=false -Dman=false -Dmode=release -Dlogind=true \
		      -Dpamconfdir=/etc/pam.d \
		      -Ddbuspolicydir=/usr/share/dbus-1/system.d -Ddbussessionservicedir=/usr/share/dbus-1/services -Ddbussystemservicedir=/usr/share/dbus-1/system-services \
		      -Dbashcompletiondir=/usr/share/bash-completion/completions \
		      -Dntp-servers="ntp1.ntsc.ac.cn ntp2.ntsc.ac.cn ntp3.ntsc.ac.cn" \
		      ..
		eval ${NINJA_AND_INSTALL}
	popd

	rm -f ${SYSROOT_DIR}/usr/lib/systemd/system/systemd-networkd-wait-online.service

popd 
rm -rf ${BUILD_DIRECTORY}/systemd-261.2

cat > ${SYSROOT_DIR}/usr/lib/systemd/system/rc-local.service << "EOF"
[Unit]
Description=/etc/rc.local Compatibility
ConditionFileIsExecutable=/etc/rc.local
After=network.target

[Service]
Type=forking
ExecStart=/etc/rc.local start
TimeoutSec=infinity
RemainAfterExit=yes
GuessMainPID=no
EOF
ln -sfv ../rc-local.service ${SYSROOT_DIR}/usr/lib/systemd/system/multi-user.target.wants/rc-local.service


set_strip_step "/usr/lib/systemd" "0"
