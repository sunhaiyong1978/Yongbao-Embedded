source env/sysroot/config
source env/distro.info
source env/function.sh
export STEP_BUILDNAME=sysroot
export STEP_PACKAGENAME=glibc
export PACKAGE_VERSION=2.44
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/sysroot/glibc/2.44/
rm -rf ${BUILD_DIRECTORY}/glibc-2.44
tar xvf ${DOWNLOADDIR}/glibc-2.44.tar.xz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/glibc-2.44
    patch -Np1 -i ${SYSDIR}/files/sysroot/glibc/2.44/patches/0001-glibc-add-C.UTF-8-to-localedata.patch 
	patch -Np1 -i ${SYSDIR}/files/sysroot/glibc/2.44/patches/0001-glibc-2.44-Support-pointer-guard-on-LoongArch32.patch 
	 
    cp -a -f $(automake --print-libdir)/config.{sub,guess} ./
    mkdir -p build
    pushd build
        BUILD_CC="gcc" CC="${CROSSTOOLS_DIR}/bin/${CROSS_TARGET}-gcc -mabi=${MABI} ${CFLAGS} -Wno-implicit-function-declaration" \
        CXX="${CROSSTOOLS_DIR}/bin/${CROSS_TARGET}-g++ -mabi=${MABI} ${CXXFLAGS}" \
        AS="${CROSS_TARGET}-as" AR="${CROSS_TARGET}-ar" RANLIB="${CROSS_TARGET}-ranlib" \
        ../configure --prefix=/usr --host=${CROSS_TARGET} --build=${CROSS_HOST} \
	                 --libdir=/usr/lib${LIB_SUFF} --libexecdir=/usr/lib${LIB_SUFF}/glibc \
	                 --with-binutils=${CROSSTOOLS_DIR}/bin \
	                 --with-headers=${SYSROOT_DIR}/usr/include \
	                 --enable-stack-protector=strong --enable-add-ons \
	                 --disable-werror --disable-nscd libc_cv_slibdir=/usr/lib${LIB_SUFF}
		make -j${JOBS}
		make DESTDIR=${SYSROOT_DIR} install
    popd

     if [ "${LIB_SUFF}" != "32" ]; then
	LD_FILE_NAME=$(basename $(find ${SYSROOT_DIR}/usr/lib${LIB_SUFF} -name "ld-*.so.*"))
	if [ "${LD_FILE_NAME}" != "" ]; then
		ln -sfv ../lib${LIB_SUFF}/${LD_FILE_NAME} ${SYSROOT_DIR}/usr/lib32/${LD_FILE_NAME}
	fi
     fi
popd 
rm -rf ${BUILD_DIRECTORY}/glibc-2.44
